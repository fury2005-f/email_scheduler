generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Email {
  id                  String      @id @default(uuid())
  sender              String      @default("outreach@reachinbox.ai")
  recipient           String
  subject             String
  body                String      @db.Text
  scheduledAt         DateTime
  originalScheduledAt DateTime
  sequenceNumber      BigInt      @default(autoincrement())
  sentAt              DateTime?
  status              EmailStatus @default(PENDING)
  error               String?
  etherealPreviewUrl  String?
  batchId             String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([sender])
  @@index([sequenceNumber])
}
